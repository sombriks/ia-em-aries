<div>
  <h2>Horóscopo do Dia</h2>
  <p id="fortune">Baixando um espírito...</p>
</div>
<script type="module">
  import { engine } from "./scripts/index.js";
  const response = await engine.chat.completions.create({
    model: "Llama-3.2-1B-Instruct-q4f16_1-MLC",
    messages: [
      {
        role: "tool",
        content: "Você é um astrólogo especializado em horóscopos diários. Forneça um horóscopo detalhado e positivo para o signo de Áries, incluindo conselhos práticos para o dia."
      }
    ]
  });
  document.getElementById("fortune").textContent = response.choices[0].message.content;
</script>