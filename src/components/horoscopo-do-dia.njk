<div>
  <h2>Horóscopo do Dia</h2>
  <p id="fortune">Baixando um espírito...</p>
</div>
<script type="module">
  import { engine } from "./scripts/index.js";
  const response = await engine.chat.completions.create({
    messages: [
      {
        role: "user",
        content: `Você é um astrólogo especializado em horóscopos diários. Forneça um horóscopo detalhado e positivo para o signo de Áries, incluindo conselhos práticos para o dia de hoje, ${new Date().toISOString().split('T')[0]}. Mantenha o tom otimista e encorajador, destacando as oportunidades e desafios que Áries pode enfrentar. Certifique-se de incluir dicas sobre amor, carreira e saúde, e termine com uma mensagem inspiradora para motivar os arianos a aproveitarem ao máximo o dia.`
      }
    ]
  });
  document.getElementById("fortune").textContent = response.choices[0].message.content;
</script>